{
  "name": "nexora-computers-server",
  "version": "1.0.0",
  "description": "Backend API server for NEXORA COMPUTERS E-Commerce & Repair Service Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "db:migrate": "tsx src/migrations/runner.ts up",
    "db:migrate:undo": "tsx src/migrations/runner.ts down",
    "seedDatabase": "tsx src/seeders/seed.seeder.ts",
    "seed": "tsx src/seeders/seed.seeder.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "umzug": "^3.8.3"
  }
}
